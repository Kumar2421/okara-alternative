# GitHub App "MLForge Studio" (hosted mode: "Connect GitHub" + code fixes via pull request).
# Public identifiers, safe to share:
GITHUB_APP_ID=5222295
GITHUB_APP_CLIENT_ID=Iv23liBWWbumM2gg4y9z
GITHUB_APP_SLUG=mlforge-studio
# Secrets. Set these in your host's environment settings, never commit real values:
GITHUB_APP_CLIENT_SECRET=
# Fix approval tickets are signed with a key derived from GITHUB_APP_CLIENT_SECRET, else NOTIFY_SIGNING_SECRET.
# Hosted mode needs at least one of them (it fails closed otherwise); the key must be stable across instances.
NOTIFY_SIGNING_SECRET=
# The App's private key (PEM). A literal "\n" in place of line breaks is accepted, e.g. "-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=
